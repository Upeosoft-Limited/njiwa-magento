<?xml version="1.0"?>
<!--
    The one topic this module publishes on.

    The payload is a string: a JSON document holding the finished message, the
    numbers it goes to, and enough of the order to write the outcome back onto
    it. It is finished at the moment the event fires rather than at the moment
    it is sent, because sales_order_place_after runs before the order row has
    been written and a worker that went looking for the order could arrive
    before it was there.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Communication/etc/communication.xsd">
    <topic name="upeo.njiwa.send" request="string">
        <handler name="upeoNjiwaSend" type="Upeo\Njiwa\Model\Consumer" method="process"/>
    </topic>
</config>
